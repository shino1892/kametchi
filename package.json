{
  "name": "kametti",
  "version": "2.0.0",
  "private": true,
  "description": "推しの Spoon 配信を手伝う Discord ボット（Spoon Developers 公式 API 版）",
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "mock": "tsx --env-file-if-exists=.env src/mock/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:pg": "vitest run --mode pg",
    "test:watch": "vitest",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "start": "node --env-file-if-exists=.env dist/index.js"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@electric-sql/pglite": "^0.5.10",
    "@types/kuromoji": "^0.1.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "discord.js": "^14.27.0",
    "hono": "^4.13.13",
    "kuromoji": "^0.1.2",
    "pg": "^8.23.1"
  }
}
