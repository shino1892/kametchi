# コピーして .env を作成する。.env はコミットしない（仕様書 §0、§10）
# 段階0では pnpm mock だけが SPOON_* を読む。ほかの値は段階1以降で使う

# 連携用ページの URL とポート（本番: https://kametchi.com）
APP_BASE_URL=http://localhost:8790
PORT=8790

# Spoon Developers（日本リージョン、運用承認後）
SPOON_BASE_URL=https://jp-openapi.spooncast.net
SPOON_AUTHORIZE_URL=https://developers.spooncast.net/jp/oauth/authorize
SPOON_CLIENT_ID=
SPOON_CLIENT_SECRET=
SPOON_REDIRECT_URI=http://localhost:8790/callback

# ---- 開発用モック（pnpm mock）を使う場合は、上の値の代わりに次を使う ----
# MOCK_SPOON_PORT=8788
# SPOON_BASE_URL=http://localhost:8788
# SPOON_AUTHORIZE_URL=http://localhost:8788/jp/oauth/authorize
# SPOON_CLIENT_ID=mock-client
# SPOON_CLIENT_SECRET=mock-secret

# PostgreSQL（共用 DB サーバーの専用ロール・DB kametchi）
DATABASE_URL=

# トークン暗号化鍵（32バイトを base64 で）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Discord（旧 kametti と同じボット・サーバー・チャンネル）
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
DISCORD_GUILD_ID=
DISCORD_MAIN_CHANNEL_ID=
DISCORD_CHAT_CHANNEL_ID=
DISCORD_DAJARE_CHANNEL_ID=

# ダジャレの投票で確定する票数
VOTE_THRESHOLD=4

# プライバシーポリシーに載せる窓口（どちらか必須）
PRIVACY_CONTACT_X=
PRIVACY_CONTACT_EMAIL=
